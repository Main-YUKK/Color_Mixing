default_platform(:ios)

platform :ios do
  desc "Sign, archive, dan upload build Unity iOS ke TestFlight"
  lane :beta do
    # --- Path & konfigurasi ---
    root         = ENV["GITHUB_WORKSPACE"] || File.expand_path("..", Dir.pwd)
    xcode_dir    = File.join(root, "build", "iOS", "iOS")
    project_path = File.join(xcode_dir, "Unity-iPhone.xcodeproj")
    plist_path   = File.join(xcode_dir, "Info.plist")
    bundle_id    = ENV["IOS_BUNDLE_ID"]
    team_id      = ENV["APPLE_TEAM_ID"]

    # --- 1. Keychain sementara untuk runner ---
    setup_ci

    # --- 2. Login ke App Store Connect ---
    api_key = app_store_connect_api_key(
      key_id:      ENV["APPSTORE_KEY_ID"],
      issuer_id:   ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_P8"],
      in_house:    false
    )

    # --- 3. Ambil sertifikat & profile dari repo certs ---
    match(
      type: "appstore",
      app_identifier: bundle_id,
      git_url: ENV["MATCH_REPOSITORY"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      api_key: api_key,
      readonly: true
    )
    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"]

    # --- 4. Build number & compliance ---
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id
    ) + 1
    set_info_plist_value(path: plist_path, key: "CFBundleVersion", value: build_number.to_s)
    set_info_plist_value(path: plist_path, key: "ITSAppUsesNonExemptEncryption", value: false)

    # --- 5. Ganti ke manual signing ---
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      targets: ["Unity-iPhone"],
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: bundle_id
    )

    # --- 6. Archive & export .ipa ---
    build_app(
      project: project_path,
      scheme: "Unity-iPhone",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { bundle_id => profile_name }
      },
      output_directory: File.join(root, "build", "ipa")
    )

    # --- 7. Upload ke TestFlight ---
    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true
    )
  end
end