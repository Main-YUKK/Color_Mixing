
default_platform(:ios)

platform :ios do

  # ============================================================
  # SHARED CONFIGURATION
  # ============================================================

  def configure_testflight
    root         = ENV["GITHUB_WORKSPACE"] || File.expand_path("..", Dir.pwd)
    xcode_dir    = File.join(root, "build", "iOS", "iOS")
    project_path = File.join(xcode_dir, "Unity-iPhone.xcodeproj")
    plist_path   = File.join(xcode_dir, "Info.plist")
    bundle_id    = ENV["IOS_BUNDLE_ID"]
    team_id      = ENV["APPLE_TEAM_ID"]

    UI.user_error!("IOS_BUNDLE_ID belum diatur") if bundle_id.to_s.empty?
    UI.user_error!("APPLE_TEAM_ID belum diatur") if team_id.to_s.empty?

    # 1. Setup temporary keychain untuk GitHub Actions
    setup_ci

    # 2. App Store Connect API authentication
    api_key = app_store_connect_api_key(
      key_id:      ENV["APPSTORE_KEY_ID"],
      issuer_id:   ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_P8"],
      in_house:    false
    )

    # 3. Ambil certificate dan provisioning profile
    match(
      type: "appstore",
      app_identifier: bundle_id,
      git_url: ENV["MATCH_REPOSITORY"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      api_key: api_key,
      readonly: true
    )

    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"]

    UI.user_error!("Provisioning profile tidak ditemukan") if profile_name.to_s.empty?

    # 4. Ambil build number terbaru dari TestFlight
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id
    ) + 1

    UI.message("Using build number: #{build_number}")

    # Update build number dan encryption compliance
    set_info_plist_value(
      path: plist_path,
      key: "CFBundleVersion",
      value: build_number.to_s
    )

    set_info_plist_value(
      path: plist_path,
      key: "ITSAppUsesNonExemptEncryption",
      value: false
    )

    # 5. Manual code signing
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      targets: ["Unity-iPhone"],
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: bundle_id
    )

    # 6. Archive dan export IPA
    build_app(
      project: project_path,
      scheme: "Unity-iPhone",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          bundle_id => profile_name
        }
      },
      output_directory: File.join(root, "build", "ipa")
    )

    {
      api_key: api_key,
      bundle_id: bundle_id
    }
  end


  # ============================================================
  # INTERNAL TESTING
  # Trigger: push to dev
  # ============================================================

  desc "Build dan upload Unity iOS ke Internal TestFlight"

  lane :beta do

    config = configure_testflight

    # Upload ke Internal TestFlight
    upload_to_testflight(
      api_key: config[:api_key],
      app_identifier: config[:bundle_id],
      skip_waiting_for_build_processing: false
    )

  end


  # ============================================================
  # EXTERNAL TESTING
  # Trigger: push to main
  # ============================================================

  desc "Build dan distribute Unity iOS ke External TestFlight"

  lane :beta_external do

    config = configure_testflight

    # Nama harus sama persis dengan External Testing Group
    external_group = "External Group Test"

    # Upload dan distribusi ke External Testing
    upload_to_testflight(
      api_key: config[:api_key],
      app_identifier: config[:bundle_id],

      distribute_external: true,
      groups: [external_group],

      changelog: "Please test the latest version of Color Mixing. Report any bugs, issues, or unexpected behavior.",

      notify_external_testers: true,

      # Tunggu build selesai diproses sebelum distribusi
      skip_waiting_for_build_processing: false
    )

  end

end
